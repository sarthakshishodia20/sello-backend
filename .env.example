# Selo Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=4000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=selo_db

# JWT
JWT_SECRET=sello_super_secret_jwt_key_change_this_in_prod
JWT_EXPIRES_IN=7d

# Optional AI provider key
# Phase 1 already returns a deterministic demo AI description without any external API key.
OPENAI_API_KEY=

# CORS - comma separated origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Upload dir (relative to project root)
UPLOAD_DIR=uploads
